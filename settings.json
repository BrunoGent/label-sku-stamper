{
  // Settings for the label stamper. Lines starting with // are notes and are ignored.
  // Change a value, save, and run again. No restart needed. true = on, false = off.
  // (The ORDER of the labels is set in the other file, sort_groups.json.)

  // ---- Where the SKU text goes on each label (points from the top-left; the label is 288 x 432)
  "x": 40,
  "y": 378,
  "size": 11,
  "colour": [0, 0, 0.85],       // red, green, blue, each 0 to 1. [0, 0, 0.85] = blue, [0, 0, 0] = black

  // ---- Label order
  "sort_labels": true,          // false = keep Shopify's order and ignore sort_groups.json

  // ---- Items with no SKU on the slip
  "title_fallback": true,       // true = stamp part of the title; false = stamp ?? CHECK SLIP instead
  "title_length": 28,           // how many characters of the title to stamp (a [bracketed option] is used in full)

  // ---- Pick list (the last page of the labels PDF)
  "picklist": true,                   // false = no pick list page
  "picklist_size": "4x6",             // "4x6" (label printer) or "a4"
  "picklist_columns": ["qty", "sku", "orders"],   // columns left to right; leave one out to hide it. Names: "qty", "sku", "orders" (SKU always shows)
  "picklist_group_titles": true,      // show each group's name as a title (from sort_groups.json)
  "picklist_page_per_group": false,   // true = start every group on a new page
  "picklist_priority_flag": true,     // true = red P<n> beside a SKU when n of its orders are priority postage, plus a PRIORITY orders count at the end. false = off

  // ---- Priority postage (whether it prints FIRST is "priority_first" at the top of sort_groups.json)
  "priority_words": ["1st class", "first class", "special delivery"],   // a label containing one of these phrases is priority. Tracked 24 is found from the big "24" on the label

  // ---- Repeat customers (the slip says "REPEAT CUSTOMER (Order #N)")
  "repeat_star": true,             // true = put * after the first SKU of a repeat customer's label. false = off
  "repeat_double_star_from": 10,   // from this many orders, put ** instead. 0 = never **

  // ---- Orders with a note (the slip has a NOTES section, e.g. "2 dark green and 2 wine purple candles")
  "note_mark": true,               // true = add a NOTE line under the SKUs on the label and list the orders in the summary. false = off
  "note_text": "{NOTE}",             // the word stamped on the label
  "keep_note_slips": true,         // true = keep that order's packing slip (4x6) right behind its label so the note can be read. false = drop it like the others

  // ---- Wording printed on Shopify's Royal Mail label (all OFF until you switch them on)
  // Each option draws a white box over the wording. Before using these, check that Royal Mail / Shopify are happy
  // for the label to be changed. Barcodes, the routing code, the service banner and the address are never touched.
  "cover_marketplace_seller": true,   // true = white box over "MARKETPLACE SELLER"
  "cover_shopify": true,              // true = white box over the word "Shopify" (the line above, "Paid and printed from", stays)
  "shopify_replacement": "beeminedorset.com",   // text written where "Shopify" was; "" = just leave it blank. Only used when cover_shopify is true
  "logo": true,                       // true = print the logo on the label
  "logo_x": 100,                       // the logo's top-left corner: points from the LEFT of the label (the label is 288 wide)
  "logo_y": 347,                       // ... and from the TOP (the label is 432 tall). 100 / 347 = the empty space in the middle of the bottom box
  "logo_height": 46,                   // logo height in points (the width follows). Too big and it runs into the text beside it
  "logo_style": "thermal",             // "thermal" = black and white, made for the thermal label printer; "colour" = the full colour logo
  "sku_to_top": true,                  // true = the SKUs start at the top left of the bottom box, where MARKETPLACE SELLER is printed (that wording is covered).
                                       // The text is kept clear of the logo and of Royal Mail's small print. false = the SKUs go at x / y above

  // ---- Safety alarm
  "layout_alarm_percent": 25,      // warn loudly if this % (or more) of orders have no SKU (Shopify may have changed the slip layout). 0 = off

  // ---- What happens after
  "open_after": true,           // open the finished PDF automatically
  "move_originals": true,       // move the original download to done\ (when picked from Downloads, or in watch mode)
  "strip_typed_text": false,    // true = remove text that was typed by hand onto the original labels

  // ---- Folders and files
  "out_dir": "Labels",
  "done_dir": "done",
  "downloads": null,            // null = your Windows Downloads folder; or a path like "D:/Downloads"
  "pattern": "shipping*.pdf",   // which downloaded files are picked up
  "watch_seconds": 2            // watch mode: how often to look for new downloads
}
